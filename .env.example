# Neon. En Node —desarrollo, pruebas, scripts— la aplicación usa el string agrupado (-pooler).
# En Cloudflare no se lee: la conexión llega por Hyperdrive (architecture.md § Deployment).
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/orbiq?sslmode=require"

# Neon directo, sin agrupador. Para migraciones —drizzle-kit necesita una sesión propia— y para
# crear el Hyperdrive de cada negocio, que agrupa por su cuenta. `npm run preview` lo usa también.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/orbiq?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generar con: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# El nombre de la tienda que se ve en Acceso, Inicio y el menú. Sin él, «Mi tienda».
# En Cloudflare va por negocio en wrangler.jsonc (T-031).
NEGOCIO_NOMBRE="Mi tienda"
