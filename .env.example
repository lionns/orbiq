# Neon. La aplicación usa el string agrupado (-pooler): serverless no sostiene conexiones
# vivas. architecture.md § Known Constraints
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/orbiq?sslmode=require"

# Neon directo, sin agrupador. Solo para migraciones: drizzle-kit necesita una sesión propia.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/orbiq?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generar con: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
